{
  "name": "formpass",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --open /popup.html",
    "build": "tsc -b && vite build && vite build --config vite.content.config.ts && vite build --config vite.background.config.ts && node scripts/package.mjs",
    "test": "node --test tests/*.test.ts",
    "check": "npm run lint && npm test && npm run build && node scripts/verify-package.mjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.2.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.11.0",
    "jsdom": "^30.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.3.5"
  }
}
