{
  "manifest_version": 3,
  "name": "FormPass",
  "version": "0.2.1",
  "description": "Preview Google Form sections and fill blank fields with temporary answers while you prepare your real response.",
  "permissions": ["activeTab", "storage"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "FormPass",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
